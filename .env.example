# Copy to .env on your private host. Do not commit .env or paste values into chat.
# A real domain with DNS pointed to your host is required for the production compose setup.
APP_DOMAIN=
ACME_EMAIL=
PUBLIC_URL=

# Required owner password. Use a unique password with at least 16 characters.
OWNER_PASSWORD=
# Optional private HTTPS iCalendar subscription for one-way polling; not a direct TimeTree API.
TIMETREE_FEED_URL=

# Production compose sets these values. For local use, bind only to loopback.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Exactly one trusted reverse proxy in compose; leave empty for a direct local connection.
TRUST_PROXY=

# Optional fixed Web Push keys; set both together. If omitted, keys are persisted in DATA_DIR.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supply a real contact, e.g. mailto:you@your-domain.ca
VAPID_SUBJECT=

# Required only when enabling automatic SMS in Settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google Calendar configuration, if the deployment supports the adapter.
# Never put secrets in VITE_* variables; those become public browser code.
