{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pm-aidan-maximization",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/calendar",
      "/calendar/*",
      "/__scheduled",
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "HARDBOND", "class_name": "HardbondWorkspace" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HardbondWorkspace"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
}
